local earthTransforms = asset.require("scene/solarsystem/planets/earth/transforms")

-- Helper function to generate fieldline nodes for different altitude layers
local function createWindLayer(identifier, name, guiPath, dataId, enabled)
  -- Synchronize the ZIP file via UrlSynchronization
  local syncedResource = asset.resource({
    Type = "UrlSynchronization",
    Name = "GFS-" .. dataId,
    Identifier = "gfs-" .. dataId,
    Url = "https://github.com/asabljic-iit/OpenSpace-GFS-Wind-Visualization/releases/download/latest/layer_"..dataId..".zip",
    SecondsUntilResync = 86400 -- Check once daily
  })

  -- Construct paths for unzip operations
  local zipFilePath = syncedResource .. "/layer_" .. dataId .. ".zip"
  local extractDir = syncedResource .. "/" .. dataId

  -- Define the Scene Graph Node pointing to the extracted directory
  local node = {
    Identifier = identifier,
    Parent = "Earth",
    Renderable = {
      Type = "RenderableFieldlinesSequence",
      LoadingType = "StaticLoading",
      SourceFolder = extractDir,
      InputFileType = "Osfls",

      LineWidth = 2.0,
      ColorMethod = "By Quantity",
      ColorQuantity = 0,
      ColorTableRanges = { { -5.0, 40.0 } },
      ColorMinMaxRange = { 0.0, 120.0 },
      ColorTablePaths = { asset.resource("wind-speed.txt") },
      Color = { 0.35, 0.50, 0.875, 1.0 },
      
      ParticleSpacing = 20.0,
      ParticleSize = 15.0,
      FlowColor = { 1.0, 1.0, 1.0, 0.25 },
      FlowSpeed = 15.0,
      FlowEnabled = true,
      ReversedFlow = true,
      Enabled = enabled
    },
    GUI = {
      Path = guiPath,
      Name = name,
      Description = "Wind fieldlines from NOAA GFS at " .. name
    }
  }

  return {
    node = node,
    zipFile = zipFilePath,
    extractDestination = syncedResource,
    layerDir = extractDir
  }
end

-- Define nodes for each altitude layer
local layers = {
  createWindLayer("Earth-Wind-Surface-10m", "Surface (10m)", "/Solar System/Planets/Earth/Atmosphere", 1001, true),
  createWindLayer("Earth-Wind-700hPa", "700 hPa (~3 km)", "/Solar System/Planets/Earth/Atmosphere", 700, false),
  createWindLayer("Earth-Wind-250hPa", "250 hPa (~10.5 km)", "/Solar System/Planets/Earth/Atmosphere", 250, false),
  createWindLayer("Earth-Wind-10hPa", "10 hPa (~31 km)", "/Solar System/Planets/Earth/Atmosphere", 10, false)
}

asset.onInitialize(function()
  for _, layer in ipairs(layers) do
    -- Unzip and delete original archive first
    if openspace.fileExists(layer.zipFile) then
      openspace.unzipFile(layer.zipFile, layer.extractDestination, true)
    end

    -- Only add node to scene graph once the directory contains raw .osfls files
    if openspace.directoryExists(layer.layerDir) then
      openspace.addSceneGraphNode(layer.node)
    end
  end
end)

asset.onDeinitialize(function()
  for _, layer in ipairs(layers) do
    openspace.removeSceneGraphNode(layer.node)
  end
end)

for _, layer in ipairs(layers) do
  asset.export(layer.node)
end